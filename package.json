{
  "name": "bklit-vue-charts",
  "version": "0.1.0-beta.4",
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "description": "Composable Vue 3 chart components (bklit-ui port) — d3 + motion-v, SVG, fully themeable.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdrizik/bklit-vue-charts.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "charts",
    "d3",
    "dataviz"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "theme.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css",
    "./theme.css": "./theme.css"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@vueuse/core": "^13.0.0 || ^14.0.0",
    "motion-v": "^2.0.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@types/d3-shape": "^3.1.8",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vueuse/core": "^14.3.0",
    "motion-v": "^2.3.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.0",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.7"
  }
}
